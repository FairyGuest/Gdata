{
    "compilerOptions":  {
                            "target":  "ES2023",
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "strict":  true,
                            "noUncheckedIndexedAccess":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "noEmit":  true,
                            "types":  [
                                          "node"
                                      ],
                            "allowImportingTsExtensions":  true
                        },
    "include":  [
                    "src/**/*.ts",
                    "test/**/*.ts",
                    "scripts/**/*.ts"
                ]
}
