{
  "name": "lint-engine-b",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rule-based lint engine for TypeScript source (regex + AST-lite), SQLite-backed, HTTP diagnostics API",
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "start": "node --no-warnings src/index.ts",
    "demo": "node --no-warnings scripts/demo.ts",
    "test": "node --no-warnings test/index.ts",
    "accept": "node --no-warnings scripts/accept.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {}
}

