{
  "name": "load-tester-a",
  "version": "1.0.0",
  "type": "module",
  "description": "HTTP load testing service with latency distribution stats and SQLite history",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-isolation=none test/*.test.ts",
    "accept": "node --disable-warning=ExperimentalWarning scripts/accept.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
