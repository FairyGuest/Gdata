{
  "name": "snapshot-test-service",
  "version": "1.0.0",
  "private": true,
  "description": "Structured snapshot testing service: serialized input vs stored snapshot with field-level diffs",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "demo": "node scripts/demo.ts",
    "accept": "node scripts/accept.ts"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}